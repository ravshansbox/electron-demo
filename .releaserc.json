{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && npm run make -- --arch=arm64,x64"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "out/make/zip/darwin/*/*.zip" }]
      }
    ]
  ]
}
